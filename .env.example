# Copy this file to .env and fill in the keys you want to use.

# Streamlit connects to the authenticated FastAPI account service.
CONSENSUS_SCOPE_BACKEND_URL=https://api.consensusscope.cn

# Backend-only settings. Do not expose these values to browser code.
CONSENSUS_SCOPE_BACKEND_DB=/opt/consensusscope-demo/data/consensusscope_backend.sqlite3
CONSENSUS_SCOPE_CORS_ORIGINS=https://demo.consensusscope.cn
CONSENSUS_SCOPE_ADMIN_USERNAMES=
CONSENSUS_SCOPE_PUBLIC_URL=https://demo.consensusscope.cn
CONSENSUS_SCOPE_REVIEW_WORKERS=4

# Optional transactional email. Leave blank to disable email delivery.
CONSENSUS_SCOPE_SMTP_HOST=
CONSENSUS_SCOPE_SMTP_PORT=587
CONSENSUS_SCOPE_SMTP_USERNAME=
CONSENSUS_SCOPE_SMTP_PASSWORD=
CONSENSUS_SCOPE_EMAIL_FROM=
CONSENSUS_SCOPE_SMTP_SSL=false
CONSENSUS_SCOPE_SMTP_STARTTLS=true

# Test-only: never enable this on a public deployment.
CONSENSUS_SCOPE_EXPOSE_ONE_TIME_TOKENS=false

# Provider keys stay on the backend. They are never sent to the browser or
# written to review exports.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-flash

KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

JUDGE_API_KEY=
JUDGE_BASE_URL=https://api.deepseek.com
JUDGE_MODEL=deepseek-chat
